---
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '@fontsource/vt323/400.css';
import { Sun, Moon } from '@lucide/astro';
import BinaryBackdrop from '../components/BinaryBackdrop.astro';
import '../styles/global.css';
import { profile, withBase } from '../lib/site';
interface Props {
  title?: string;
  description?: string;
  active?: 'home' | 'research' | 'about';
  article?: boolean;
  lang?: string;
}
const { title = profile.name, description = profile.description, active = 'home', article = false, lang = 'en' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const navigation = [{ label: 'Home', path: '', key: 'home' }, { label: 'Research', path: 'research/', key: 'research' }, { label: 'About', path: 'about/', key: 'about' }];
---
<!doctype html>
<html lang={lang} data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#000000" />
    <meta name="description" content={description} />
    <title>{title === profile.name ? `${title} — Security Research` : `${title} — ${profile.name}`}</title>
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
    <script is:inline>
      try { if (localStorage.getItem('color-theme') === 'light') document.documentElement.dataset.theme = 'light'; } catch {}
    </script>
    <link rel="alternate" type="application/rss+xml" title={`${profile.name} — Research`} href={withBase('rss.xml')} />
  </head>
  <body class:list={{ 'article-page': article }}>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header shell" lang="en">
      <a class="wordmark" href={withBase()} aria-label={`${profile.name}, home`}>{profile.handle}</a>
      <div class="header-actions flex items-center">
        <button class="theme-toggle" data-theme-toggle hidden aria-label="Switch to light theme"><Sun class="sun-icon" size={19} aria-hidden="true" /><Moon class="moon-icon" size={19} aria-hidden="true" /></button>
        <nav aria-label="Main navigation">{navigation.map(item => <a href={withBase(item.path)} aria-current={active === item.key ? 'page' : undefined}>{item.label}</a>)}</nav>
      </div>
    </header>
    <main id="main" class="shell" tabindex="-1"><slot /></main>
    <footer class="site-footer" lang="en">
      <BinaryBackdrop />
      <div class="footer-inner shell"><p class="copyright">© {new Date().getFullYear()} {profile.name}. All rights reserved.</p><div class="footer-links"><a href={profile.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a><a href={withBase('rss.xml')}>RSS ↗</a></div></div>
    </footer>
  </body>
</html>
<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  if (toggle) {
    toggle.hidden = false;
    const syncTheme = () => {
      const light = document.documentElement.dataset.theme === 'light';
      toggle.setAttribute('aria-label', light ? 'Switch to dark theme' : 'Switch to light theme');
      document.querySelector('meta[name="theme-color"]')?.setAttribute('content', light ? '#f6f6f0' : '#000000');
    };
    syncTheme();
    toggle.addEventListener('click', () => {
      const theme = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
      document.documentElement.dataset.theme = theme;
      try { localStorage.setItem('color-theme', theme); } catch {}
      syncTheme();
    });
  }
</script>
