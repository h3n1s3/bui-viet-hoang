---
import { Mail, Box } from '@lucide/astro';
import { socials } from '../data/profile';
const paths = {
 github: 'M12 .75a11.25 11.25 0 0 0-3.56 21.92c.56.1.77-.24.77-.54v-2.1c-3.13.68-3.79-1.33-3.79-1.33-.51-1.3-1.25-1.65-1.25-1.65-1.02-.7.08-.69.08-.69 1.13.08 1.73 1.16 1.73 1.16 1 1.72 2.64 1.23 3.28.94.1-.73.39-1.23.71-1.51-2.5-.28-5.13-1.25-5.13-5.56 0-1.23.44-2.23 1.16-3.02-.12-.28-.5-1.43.11-2.98 0 0 .95-.3 3.1 1.15a10.8 10.8 0 0 1 5.64 0c2.15-1.46 3.1-1.15 3.1-1.15.61 1.55.23 2.7.11 2.98.72.79 1.16 1.79 1.16 3.02 0 4.32-2.64 5.28-5.15 5.56.4.35.76 1.04.76 2.1v3.08c0 .3.2.65.78.54A11.25 11.25 0 0 0 12 .75Z',
 facebook: 'M14 21v-8h3l.5-4H14V7c0-1 .3-1.5 1.7-1.5H18V2.2c-.4-.1-1.8-.2-3-.2-3 0-5 1.8-5 5v2H7v4h3v8z',
 linkedin: 'M5.2 7.4a2.2 2.2 0 1 0 0-4.4 2.2 2.2 0 0 0 0 4.4ZM3.4 9h3.7v12H3.4zM9.5 9H13v1.6h.1c.5-.9 1.7-1.9 3.5-1.9 3.7 0 4.4 2.4 4.4 5.5V21h-3.7v-6c0-1.4 0-3.2-2-3.2s-2.2 1.5-2.2 3.1V21H9.5z',
};
---
<div class="social-links" aria-label="Social profiles">{socials.map(s=><a class="social-link" href={s.url} target={s.url.startsWith('mailto:')?undefined:'_blank'} rel="noopener noreferrer" aria-label={s.label}>{s.icon==='mail'?<Mail size={21} aria-hidden="true"/>:s.icon==='htb'?<Box size={21} aria-hidden="true"/>:<svg width="21" height="21" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={paths[s.icon]}/></svg>}<span aria-hidden="true">{s.label}</span></a>)}</div>
