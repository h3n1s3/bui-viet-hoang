---
import type { CollectionEntry } from 'astro:content';
import { formatDate, withBase } from '../lib/site';
interface Props { posts: CollectionEntry<'research'>[] }
const { posts } = Astro.props;
---
<div class="research-list">
  {posts.map(post => <article class="research-row" lang={post.data.lang}>
    <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
    <div class="research-summary">
      <h3><a href={withBase(`research/${post.id}/`)}>{post.data.title}<span class="row-arrow" aria-hidden="true">↗</span></a></h3>
      <p>{post.data.description}</p>
      <div class="tags" aria-label="Article tags">{post.data.tags.map(tag => <span>{tag}</span>)}{post.data.sample && <span class="sample-label">Sample note</span>}</div>
    </div>
  </article>)}
</div>
