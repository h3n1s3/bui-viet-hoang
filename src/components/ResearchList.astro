---
import type { CollectionEntry } from 'astro:content';
import { ChevronRight } from '@lucide/astro';
import { formatDate, withBase } from '../lib/site';
interface Props { posts: CollectionEntry<'research'>[]; headingLevel?: 'h2' | 'h3' }
const { posts, headingLevel: Heading = 'h3' } = Astro.props;
---
<div class="research-grid grid grid-cols-1 md:grid-cols-2 gap-5">
  {posts.map(post => (
    <article class="research-card" data-category={post.data.category} lang={post.data.lang}>
      <a class="card-link" href={withBase(`research/${post.id}/`)} aria-labelledby={`post-${post.id}`}>
        <div class="card-titlebar" aria-hidden="true"><span class="card-dot"></span><span class="card-dot"></span><span class="card-dot"></span></div>
        <div class="card-body">
          <Heading class="card-title" id={`post-${post.id}`}><ChevronRight size={21} class="card-prompt" aria-hidden="true" />{post.data.title}</Heading>
          <time datetime={post.data.date.toISOString()}>[{formatDate(post.data.date)}]</time>
          <p class="card-description">{post.data.description}</p>
          <div class="card-bottom">
            <span class="card-read-more" lang="en">Read more <ChevronRight size={17} aria-hidden="true" /></span>
            <div class="tags card-tags" aria-label="Article tags">{post.data.tags.map(tag => <span>{tag}</span>)}</div>
          </div>
          {post.data.sample && <span class="sample-label" lang="en">Sample note</span>}
        </div>
      </a>
    </article>
  ))}
</div>
