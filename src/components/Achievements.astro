---
import { ctfAchievements, securityAchievements, socials } from '../data/profile';
const patchstack = 'https://patchstack.com/database/researchers/e2b27fb5-836f-4e3e-8ae7-9a8c92082c69';
const htb = socials.find(({ icon }) => icon === 'htb')?.url;
---
<section id="achievements" class="home-section achievements reveal" aria-labelledby="achievements-heading">
 <div class="section-heading"><h2 id="achievements-heading">&lt;Achievements /&gt;</h2></div>
 <div class="achievement-stack">
  <section aria-labelledby="security-achievements"><p class="eyebrow">{String(securityAchievements.length).padStart(2, '0')} / VULNERABILITY DISCLOSURE</p><h3 id="security-achievements">Security Research<span class="terminal-cursor" aria-hidden="true">_</span></h3>
   {securityAchievements.map(item => <article class="achievement-entry">
    <div class="achievement-meta"><span class:list={['status-badge', { pending: item.status === 'in-disclosure' }]}>{item.statusLabel}</span>{item.date && <time datetime={item.date}>{item.dateLabel ?? item.date}</time>}{item.meta && <span>{item.meta}</span>}</div>
    <h4>{item.url ? <a href={item.url} target="_blank" rel="noopener noreferrer">{item.title} <span aria-hidden="true">↗</span></a> : item.title}</h4>
    <p>{item.description}</p>
    {item.credit && <p class="achievement-credit">{item.credit}</p>}
    {item.advisoryUrl && <a class="text-link" href={item.advisoryUrl} target="_blank" rel="noopener noreferrer">{item.advisoryLabel ?? 'Read advisory'} ↗</a>}
   </article>)}
   <a class="text-link" href={patchstack} target="_blank" rel="noopener noreferrer">Patchstack researcher profile ↗</a>
  </section>
  <section aria-labelledby="ctf-achievements"><p class="eyebrow">{String(ctfAchievements.length).padStart(2, '0')} / COMPETITIONS & PRACTICE</p><h3 id="ctf-achievements">CTF<span class="terminal-cursor" aria-hidden="true">_</span></h3>
   {ctfAchievements.length ? ctfAchievements.map(item => <article class="achievement-entry"><div class="achievement-meta">{item.date && <time datetime={item.date}>{item.dateLabel ?? item.date}</time>}</div><h4>{item.title}</h4><p>{item.description}</p>{item.url && <a class="text-link" href={item.url} target="_blank" rel="noopener noreferrer">{item.linkLabel ?? 'View result'} ↗</a>}</article>) : <p class="ctf-note">CTF writeups, competition results and milestones will be collected here.</p>}
   {htb && <a class="text-link" href={htb} target="_blank" rel="noopener noreferrer">Hack The Box ↗</a>}
  </section>
 </div>
</section>
