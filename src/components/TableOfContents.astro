---
import type { MarkdownHeading } from 'astro';
interface Props { headings: MarkdownHeading[] }
const headings = Astro.props.headings.filter(heading => heading.depth === 2 || heading.depth === 3);
---
{headings.length > 0 && <><div class="reading-progress-global" aria-hidden="true"><span data-reading-progress-global></span></div><aside class="toc-aside"><details class="toc" open data-toc><summary>ON THIS PAGE <span aria-hidden="true">+</span></summary><nav aria-label="Table of contents"><ol>{headings.map(heading => <li class:list={{ 'toc-nested': heading.depth === 3 }}><a href={`#${heading.slug}`} data-toc-link>{heading.text}</a></li>)}</ol></nav></details><div class="toc-progress" aria-hidden="true"><span data-reading-progress></span></div></aside></>}
<script>
  const toc = document.querySelector<HTMLDetailsElement>('[data-toc]');
  if (toc) {
    const desktop = matchMedia('(min-width: 1280px)');
    const aside = toc.closest<HTMLElement>('.toc-aside')!;
    aside.classList.add('toc-floating');
    document.addEventListener('keydown', event => { if(event.key === 'Escape' && !desktop.matches && toc.open) { toc.open=false; toc.querySelector('summary')?.focus(); } });
    document.addEventListener('click', event => { if(!desktop.matches && !aside.contains(event.target as Node)) toc.open=false; });
    const syncLayout = () => { toc.open = desktop.matches; };
    syncLayout();
    desktop.addEventListener('change', syncLayout);
    const links = [...toc.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')];
    const sections = links.map(link => document.getElementById(decodeURIComponent(link.hash.slice(1))));
    let current = -1;
    function updateActive() {
      const article = document.querySelector<HTMLElement>('.article-content');
      const progress = document.querySelector<HTMLElement>('[data-reading-progress]');
      const globalProgress = document.querySelector<HTMLElement>('[data-reading-progress-global]');
      if (article && progress) {
        const box = article.getBoundingClientRect();
        const value = String(Math.max(0, Math.min(1, (140 - box.top) / Math.max(1, box.height - innerHeight + 140))));
        progress.style.setProperty('--progress', value);
        globalProgress?.style.setProperty('--progress', value);
      }
      let next = 0;
      sections.forEach((section, index) => { if (section && section.getBoundingClientRect().top <= 140) next = index; });
      if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 8) next = links.length - 1;
      if (next === current) return;
      current = next;
      links.forEach((link, index) => { if (index === next) link.setAttribute('aria-current', 'location'); else link.removeAttribute('aria-current'); });
    }
    let scheduled = false;
    const scheduleUpdate = () => {
      if (scheduled) return;
      scheduled = true;
      requestAnimationFrame(() => { updateActive(); scheduled = false; });
    };
    window.addEventListener('scroll', scheduleUpdate, { passive: true });
    window.addEventListener('resize', scheduleUpdate);
    window.addEventListener('load', scheduleUpdate);
    new ResizeObserver(scheduleUpdate).observe(document.querySelector('.article-content')!);
    links.forEach((link, index) => link.addEventListener('click', event => {
      if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      const target = sections[index];
      if (!target) return;
      event.preventDefault();
      if (!desktop.matches) toc.open = false;
      history.pushState(null, '', link.hash);
      target.setAttribute('tabindex', '-1');
      target.focus({ preventScroll: true });
      target.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth' });
    }));
    updateActive();
  }
</script>
