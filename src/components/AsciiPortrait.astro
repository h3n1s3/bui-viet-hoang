---
import layers from '../data/elaina-ascii.json';
---
<figure class="elaina-art" aria-label="Elaina illustrated in ASCII characters, with gently moving silver hair">
  <svg viewBox="0 0 1080 1920" role="img" aria-labelledby="elaina-title" preserveAspectRatio="xMidYMid meet">
    <title id="elaina-title">Elaina — ASCII portrait</title>
    {Object.entries(layers).map(([name,rows]) => <g aria-hidden="true" class={`ascii-${name}`} fill="currentColor" font-family="'Courier New', monospace" font-size="10" xml:space="preserve">{rows.map((row,index)=><text x="0" y={index*12+10}>{row}</text>)}</g>)}
  </svg>
  <figcaption>ELAINA <span aria-hidden="true">/</span> ASCII STUDY <span class="terminal-cursor" aria-hidden="true">_</span></figcaption>
</figure>

