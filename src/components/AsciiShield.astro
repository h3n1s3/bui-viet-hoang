---
// An original text illustration, generated at build time; no image or animation.
const rows = Array.from({ length: 35 }, (_, y) => {
  const halfWidth = y < 7 ? 4 + y * 3 : y < 21 ? 24 - (y - 7) * .25 : 20.5 - (y - 21) * 1.5;
  return Array.from({ length: 57 }, (_, x) => {
    const distance = Math.abs(x - 28);
    if (distance > halfWidth) return ' ';
    if (distance > halfWidth - 2) return '#';
    if (y === 16 && x >= 20 && x < 37) return '   < / >         '[x - 20];
    if (y >= 13 && y <= 19 && distance < 12) return ' ';
    return ['0', '1', ':', '.', '+', '1', '0'][(x * 7 + y * 3 + x * y) % 7];
  }).join('');
});
---
<div class="ascii-art" aria-hidden="true"><pre>{rows.join('\n')}</pre><span>RESEARCH / BUILD / BREAK</span></div>
