---
interface Props { hero?: boolean }
const { hero = false } = Astro.props;
const seed = '01101000 00110011 01101110 00110001 01110011 00110011 ';
const rows = Array.from({ length: hero ? 12 : 3 }, (_, i) => `${seed.slice(i)}${seed.repeat(8)}`);
---
<div class:list={['binary-backdrop', { 'binary-hero': hero }]} aria-hidden="true">
  {rows.map(row => <div>{row}</div>)}
</div>
