---
import Layout from '../layouts/Layout.astro';
import ResearchList from '../components/ResearchList.astro';
import { profile, withBase } from '../lib/site';
import { getResearch } from '../lib/research';
const posts = await getResearch();
---
<Layout>
  <section class="home-intro">
    <p class="eyebrow">PERSONAL SITE / SECURITY RESEARCH</p>
    <h1>Hi, I'm {profile.name}<span class="accent">.</span></h1>
    <p class="hero-statement">I research, build and break things<br class="desktop-break" /> <span>in cybersecurity.</span></p>
    <p class="hero-role">{profile.role}</p>
    <div class="hero-links"><a class="primary-link" href={withBase('research/')}>Explore research <span aria-hidden="true">↗</span></a><a class="text-link" href={profile.github} target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a></div>
  </section>
  <section class="latest-section" aria-labelledby="latest-heading">
    <div class="section-heading"><h2 id="latest-heading"><span aria-hidden="true">&lt;</span> Latest research <span aria-hidden="true">/&gt;</span></h2><a href={withBase('research/')}>View all <span aria-hidden="true">↗</span></a></div>
    {posts.length ? <ResearchList posts={posts.slice(0, 3)} /> : <p class="empty-state">Research notes are on the way.</p>}
  </section>
</Layout>
