---
import { ArrowDown, ArrowUpRight } from '@lucide/astro';
import Layout from '../layouts/Layout.astro';
import BinaryBackdrop from '../components/BinaryBackdrop.astro';
import AsciiPortrait from '../components/AsciiPortrait.astro';
import SocialLinks from '../components/SocialLinks.astro';
import Certifications from '../components/Certifications.astro';
import Achievements from '../components/Achievements.astro';
import { profile, withBase } from '../lib/site';
import { getResearch } from '../lib/research';
import { certifications, projects } from '../data/profile';
const posts = await getResearch();
---
<Layout>
 <section class="home-intro hero-expanded">
  <BinaryBackdrop hero />
  <div class="hero-copy"><p class="hero-name">Hi, I'm {profile.name}.</p><h1>&lt;{profile.handle} /&gt;<span class="terminal-cursor" aria-hidden="true">_</span></h1><p class="hero-statement">{profile.description}</p><p class="hero-role">{profile.role}</p><SocialLinks/></div>
  <AsciiPortrait/>
  <a class="scroll-cue" href="#overview">SCROLL TO EXPLORE <ArrowDown size={16} aria-hidden="true"/></a>
 </section>
 <section class="home-stats reveal" id="overview" aria-label="Website overview">
  <div class="stat-item" style="--stat-delay:0ms"><strong>{String(posts.length).padStart(2,'0')}</strong><span>RESEARCH NOTES</span><small>includes sample articles</small></div>
  <div class="stat-item" style="--stat-delay:90ms"><strong>{String(posts.filter(p=>p.data.category==='writeup').length).padStart(2,'0')}</strong><span>WRITEUPS</span><small>CTF & lab notes</small></div>
  <div class="stat-item" style="--stat-delay:180ms"><strong>{String(certifications.length).padStart(2,'0')}</strong><span>CERTIFICATIONS</span><small>public credentials</small></div>
  <div class="stat-item" style="--stat-delay:270ms"><strong>{String(projects.length).padStart(2,'0')}</strong><span>PROJECTS</span><small>open source & experiments</small></div>
 </section>
 <Certifications/>
 <section id="about" class="home-section home-about reveal" aria-labelledby="about-heading">
  <div class="section-heading"><h2 id="about-heading">&lt;About Me /&gt;</h2></div>
  <div class="about-grid"><div><p class="command about-command"><span class="terminal-cursor" aria-hidden="true">$</span> whoami</p><h3>{profile.name}<span class="muted"> / {profile.handle}</span></h3><p>I am an information security student at the Academy of Cryptography Techniques, focused on web application security, penetration testing, and bug bounty research. My work sits at the boundary between design and behavior: I read source code, form testable hypotheses, and reproduce security issues in controlled local labs. I document each finding from root cause to practical impact, and I also design CTF challenges and publish writeups to make the underlying techniques easier to learn.</p><SocialLinks/></div><div class="about-focus"><section><span>01 / FOCUS AREAS</span><h3>Web application security</h3><p>Authentication, authorization, access control, and the root causes behind modern web vulnerabilities.</p></section><section><span>02 / RESEARCH APPROACH</span><h3>Hypothesis. Reproduce. Document.</h3><p>Source-led analysis, controlled local labs, and evidence that another researcher can verify.</p><a class="text-link" href={withBase('research/')}>Explore research <ArrowUpRight size={16}/></a></section></div></div>
 </section>
 <Achievements />
</Layout>
